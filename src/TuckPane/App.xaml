<Application
    x:Class="TuckPane.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="GlassTextPrimary">#F7F9FF</Color>
            <Color x:Key="GlassTextSecondary">#AEB7CB</Color>
            <SolidColorBrush x:Key="GlassTextPrimaryBrush" Color="{StaticResource GlassTextPrimary}" />
            <SolidColorBrush x:Key="GlassTextSecondaryBrush" Color="{StaticResource GlassTextSecondary}" />
            <ControlTemplate x:Key="ConsoleSliderThumbTemplate" TargetType="Thumb">
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" />
            </ControlTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
